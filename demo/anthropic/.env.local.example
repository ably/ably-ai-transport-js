# Ably API key. Get one at https://ably.com/accounts
# The key's app needs the mutableMessages rule on its ai namespace. A new app
# has it; an older one fails the first append with error 93002. See the README.
ABLY_API_KEY=your-app.key:secret

# Anthropic API key, and optionally a model (the default is claude-sonnet-5-5).
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
