# Ably API key. Get one at https://ably.com/accounts
# The key's app needs the mutableMessages rule on its ai namespace. A new app
# has it; an older one fails the first append with error 93002. See the README.
ABLY_API_KEY=your-app.key:secret

# The model. Set MOCK_LLM=1 to run without a provider: the mock echoes the
# prompt back, streamed in pieces.
MOCK_LLM=1

# Or an Anthropic key (and, optionally, a model; the default is claude-sonnet-4-6).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Or an OpenAI key (and, optionally, a model; the default is gpt-4o-mini).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
