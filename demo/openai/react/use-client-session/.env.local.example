# Ably API key — get one at https://ably.com/accounts
ABLY_API_KEY=your-app.key:secret

# OpenAI — get a key at https://platform.openai.com
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional, custom / compatible endpoint
# OPENAI_MODEL=gpt-5.5                          # optional, default: gpt-5.5 (OpenAI's recommended default, early July 2026)

# Opt into streaming a reasoning model's summarised "thinking" (shown as a
# "💭 thinking" block). Off by default so casual demo users don't spend reasoning
# tokens on every turn; a reasoning-heavy prompt is needed to see a non-empty
# summary.
# SHOW_REASONING=1

# Demonstrate the no-store / zero-data-retention (ZDR) case: run the request with
# store: false, so a reasoning model's chain-of-thought must round-trip in-band as
# the reasoning item's encrypted_content across turns (the codec preserves it).
# Combine with SHOW_REASONING=1 and a reasoning-heavy prompt to observe it.
# STATELESS=1

# Return per-token log probabilities for the assistant's output text
# (include: ['message.output_text.logprobs'] + top_logprobs). The codec folds
# them onto the projected output_text part — carried on the finalised
# response.output_item.done message (see the debug pane's Ably tab) and visible
# on the assistant turn in the Turns tab. Only the reasoning-free models support
# logprobs, so pair it with a non-reasoning model.
# OPENAI_MODEL=gpt-4.1
# LOGPROBS=1

# Ably channel namespace (optional, default: ai:). The session channel is this
# namespace plus a random slug; override the whole name per-session via the
# ?channel=<name> query param (the name must sit within the namespace).
# NEXT_PUBLIC_ABLY_CHANNEL_NAMESPACE=ai:
