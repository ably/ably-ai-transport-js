# Ably API key — get one at https://ably.com/accounts
ABLY_API_KEY=your-app.key:secret

# OpenAI — get a key at https://platform.openai.com
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional, custom / compatible endpoint
# OPENAI_MODEL=gpt-5.5                          # optional, default: gpt-5.5 (OpenAI's recommended default, early July 2026)

# Opt into streaming a reasoning model's summarised "thinking" (shown as a
# "💭 thinking" block). Off by default so casual demo users don't spend reasoning
# tokens on every turn; a reasoning-heavy prompt is needed to see a non-empty
# summary.
# SHOW_REASONING=1

# Ably channel namespace (optional, default: ai:). The session channel is this
# namespace plus a random slug; override the whole name per-session via the
# ?channel=<name> query param (the name must sit within the namespace).
# NEXT_PUBLIC_ABLY_CHANNEL_NAMESPACE=ai:
