{
  "name": "@ably-ai-demos/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React UI components for the @ably/ai-transport demos. Source-only; consumers transpile via Next.js `transpilePackages`.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers.tsx",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/base.css": "./src/styles/base.css",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@ably/ai-transport": "*",
    "ably": "^2",
    "ai": "^6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ably/ai-transport": "link:../..",
    "@eslint/js": "^10",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ably": "^2.23.0",
    "ai": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "jsdom": "^26",
    "next-themes": "^0.4.6",
    "prettier": "^3",
    "radix-ui": "^1.6.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}
