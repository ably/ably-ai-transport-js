{
  "name": "@ably-ai-demos/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React UI components for the @ably/ai-transport demos. Source-only; consumers transpile via Next.js `transpilePackages`.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers.tsx",
    "./styles/base.css": "./src/styles/base.css",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ably/ai-transport": "*",
    "ably": "^2",
    "ai": "^6",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ably/ai-transport": "link:../..",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ably": "^2.23.0",
    "ai": "^6",
    "jsdom": "^26",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5",
    "vitest": "^4"
  }
}
