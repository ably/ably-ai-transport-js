# Ably API key, read by the Next.js app and the worker. Get one at https://ably.com/accounts
# The key's app needs the mutableMessages rule on its ai namespace. A new app
# has it; an older one fails the first append with error 93002.
ABLY_API_KEY=your-app.key:secret

# The Temporal server. `temporal server start-dev` listens here.
TEMPORAL_ADDRESS=localhost:7233

# The model, used by the worker. Set MOCK_LLM=1 to run without a provider:
# the mock echoes the prompt back, streamed in pieces.
MOCK_LLM=1

# Or an Anthropic key (and, optionally, a model; the default is claude-sonnet-4-6).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Or an OpenAI key (and, optionally, a model; the default is gpt-4o-mini).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
