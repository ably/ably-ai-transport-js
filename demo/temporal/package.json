{
  "name": "ably-ai-transport-temporal-demo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx --env-file=.env.local src/temporal/worker.ts",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ably/ai-transport": "link:../..",
    "@ably/pubsub-device": "link:../../node_modules/@ably/pubsub-device",
    "@ably/pubsub-server": "file:../../../ably-js/packages/server",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4",
    "@ai-sdk/react": "^4",
    "@temporalio/activity": "1.27.0",
    "@temporalio/client": "1.27.0",
    "@temporalio/common": "1.27.0",
    "@temporalio/plugin": "1.27.0",
    "@temporalio/vercel-ai-sdk": "2.0.0",
    "@temporalio/worker": "1.27.0",
    "@temporalio/workflow": "1.27.0",
    "@temporalio/workflow-streams": "1.27.0",
    "ai": "^7",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "tsx": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.3.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "download"
    }
  }
