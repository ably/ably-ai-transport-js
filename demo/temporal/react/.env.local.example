# Ably API key — get one at https://ably.com/accounts
ABLY_API_KEY=your-app.key:secret

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Temporal address. Defaults to 127.0.0.1:7233 — the address used by
# `temporal server start-dev`. Use the IPv4 literal: tonic (the Rust
# gRPC client inside @temporalio/core-bridge) resolves "localhost" via
# system DNS rather than /etc/hosts and can pick ::1, which the dev
# server does not bind to (causing GetSystemInfo to fail with
# ConnectionReset).
# TEMPORAL_ADDRESS=127.0.0.1:7233

# Temporal task queue. Both the API route and the worker must agree.
# TEMPORAL_TASK_QUEUE=ai-transport-chat

# Optional — defaults to "demo-session". Override per-tab via ?session=<name>.
# NEXT_PUBLIC_ABLY_SESSION=demo-session

# Optional — Anthropic model. Defaults to claude-haiku-4-5.
# MODEL=claude-haiku-4-5

# Optional — namespace prefix for the Ably channel. The codec's streaming
# path uses message.append/update, which require a mutable-messages
# namespace. Set this if your app's default namespace is not mutable.
# NEXT_PUBLIC_ABLY_NAMESPACE=ai
