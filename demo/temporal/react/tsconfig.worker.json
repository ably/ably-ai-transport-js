{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "noEmit": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "jsx": "preserve"
  },
  "include": ["src/temporal/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
