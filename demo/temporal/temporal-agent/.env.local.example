# Ably API key — get one at https://ably.com/accounts
ABLY_API_KEY=your-app.key:secret

# AI provider — configure one of the following (priority: anthropic > gateway > openai)

# Option A: Anthropic — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Option B: Vercel AI Gateway
# AI_GATEWAY_API_KEY=...
# AI_GATEWAY_MODEL=openai/gpt-4o-mini   # optional, default: openai/gpt-4o-mini

# Option C: OpenAI or any OpenAI-compatible endpoint
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional, custom endpoint
# OPENAI_MODEL=gpt-4o                          # optional, default: gpt-4o

# Ably channel name (optional, default: ai:demo)
# Can also be overridden per-page via ?channel=<name> query param
# NEXT_PUBLIC_ABLY_CHANNEL=ai:demo

# Temporal dev server address (start with `temporal server start-dev`)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-transport-demo

# Temporal Web UI (linked from the debug pane)
NEXT_PUBLIC_TEMPORAL_UI=http://localhost:8233
