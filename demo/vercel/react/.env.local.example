# Ably API key — get one at https://ably.com/accounts
ABLY_API_KEY=your-app.key:secret

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to "demo-session". Override per-tab via ?session=<name>.
# NEXT_PUBLIC_ABLY_SESSION=demo-session

# Optional — Anthropic model. Defaults to claude-haiku-4-5.
# MODEL=claude-haiku-4-5

# Optional — namespace prefix for the Ably channel. The codec's streaming
# path uses message.append/update, which require a mutable-messages
# namespace. Set this if your app's default namespace is not mutable.
# ABLY_NAMESPACE=mutable
