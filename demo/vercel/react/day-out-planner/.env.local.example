# Ably API key — get one at https://ably.com/accounts
ABLY_API_KEY=your-app.key:secret

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Ably channel name (optional, default: ai:day-out-planner:demo).
# Must live in the `ai:` namespace so AI Transport's mutable messages work.
# Can also be overridden per-session via ?channel=<name> query param.
# NEXT_PUBLIC_ABLY_CHANNEL=ai:day-out-planner:demo
