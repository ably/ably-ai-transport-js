# Ably API key — get one at https://ably.com/accounts
ABLY_API_KEY=your-app.key:secret

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Prefix for auto-generated channel names (optional, default: ait:)
# Each fresh visit generates a channel like "<namespace><word-word-word>".
# To pin a specific channel, use ?channel=<name> in the URL instead.
# NEXT_PUBLIC_ABLY_CHANNEL_NAMESPACE=ait:
