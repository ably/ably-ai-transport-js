{
  "name": "@ably/ai-transport",
  "version": "0.8.0",
  "description": "Ably transport and codecs for building AI applications with Ably.",
  "type": "module",
  "main": "dist/ably-ai-transport.umd.cjs",
  "module": "dist/ably-ai-transport.js",
  "browser": "dist/ably-ai-transport.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/ably-ai-transport.umd.cjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/ably-ai-transport.umd.cjs",
      "import": "./dist/ably-ai-transport.js",
      "require": "./dist/ably-ai-transport.umd.cjs"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "react-native": "./dist/vercel/ably-ai-transport-vercel.umd.cjs",
      "import": "./dist/vercel/ably-ai-transport-vercel.js",
      "require": "./dist/vercel/ably-ai-transport-vercel.umd.cjs"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "react-native": "./dist/openai/ably-ai-transport-openai.umd.cjs",
      "import": "./dist/openai/ably-ai-transport-openai.js",
      "require": "./dist/openai/ably-ai-transport-openai.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:core && pnpm run build:vercel && pnpm run build:openai",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:core": "vite build --config ./src/vite.config.ts",
    "build:vercel": "vite build --config ./src/vercel/vite.config.ts --emptyOutDir",
    "build:openai": "vite build --config ./src/openai/vite.config.ts --emptyOutDir",
    "prepare": "pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .; (pnpm run format > /dev/null)",
    "format": "prettier --list-different --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "check:error-codes": "tsx scripts/validate-error-codes.ts",
    "precommit": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none"
  },
  "files": [
    "dist/**",
    "src/**",
    "vercel/**",
    "openai/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ably/ably-ai-transport-js.git"
  },
  "keywords": [
    "ai",
    "ably",
    "ably-realtime",
    "transport",
    "websockets"
  ],
  "author": "Ably Realtime",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ably/ably-ai-transport-js/issues"
  },
  "homepage": "https://github.com/ably/ably-ai-transport-js#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "download"
    }
  },
  "peerDependencies": {
    "ably": "^2.23.0",
    "ai": "^6 || ^7",
    "openai": "^6"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.2",
    "ai": "^7.0.30",
    "eslint": "^10.2.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prefer-arrow-functions": "^3.6.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "openai": "6.45.0",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.13",
    "typedoc-plugin-no-inherit": "^1.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  }
}
